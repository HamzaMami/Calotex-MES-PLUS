# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=mes_db
# Set to "true" to enable SSL (managed/cloud databases)
DB_SSL=false

# JWT
# Use a strong, unique value in production (>= 16 chars). Do NOT use the default.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN=7d

# CORS: comma-separated list of allowed origins.
# Leave empty to allow all origins (development only).
CORS_ORIGINS=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Calotex MES <noreply@calotex.com>
# Set to "true" to skip sending emails in local development
DISABLE_EMAILS=true
